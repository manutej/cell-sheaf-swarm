{
  "name": "cell-sheaf-swarm",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Cellular sheaf contract + swarm observatory kernel. Restriction color is glue. Gold is earned.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/manutej/cell-sheaf-swarm.git"
  },
  "scripts": {
    "episode": "node --experimental-strip-types --no-warnings scripts/verdict-to-episode.mjs",
    "sheaf:validate": "node scripts/validate-sheaf.mjs",
    "federation:run": "node scripts/run-federated-loop.mjs",
    "pulse:run": "node scripts/pulse-run.mjs",
    "test": "node --test scripts/validate-sheaf.test.mjs scripts/federated-loop.test.mjs scripts/pulse-run.test.mjs scripts/worker-adapter.test.mjs scripts/eval-harness.test.mjs scripts/insight-headline.test.mjs",
    "observatory:dev": "npm run dev --prefix observatory",
    "observatory:build": "npm run build --prefix observatory"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "zod": "^3.24.0"
  },
  "files": [
    "contracts",
    "src/lib/swarm",
    "scripts/pulse-run.mjs",
    "scripts/pulse-run-cli.ts",
    "src/components/swarm",
    "scripts/validate-sheaf.mjs",
    "LICENSE",
    "README.md"
  ]
}
